# Para HealthGuideAI_Gemini.ipynb (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Para HealthGuideAI_Gemini.ipynb (NVIDIA) #Estamos trabajando sobre este modelo para la demo
NVIDIA_API_KEY=tu_api_key_de_nvidia_aqui

# Limites de la llamada al proveedor. Evitan requests colgados o reintentos excesivos.
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=0

# Por defecto la evidencia NO guarda texto médico ni respuestas completas.
EVIDENCE_INCLUDE_SENSITIVE_PAYLOADS=false

# Limite de requests a /api/triage por IP (cada una cuesta una llamada real a NVIDIA).
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Origenes permitidos para el frontend (separados por coma). Los de local/Docker
# ya vienen incluidos por defecto en config.py; solo hace falta definir esto
# cuando se despliega en un dominio real, ej.: https://healthguide.miapp.com
# CORS_ALLOWED_ORIGINS=https://healthguide.miapp.com

# Duracion de la cookie de sesion, en segundos. Por defecto ~1 año (no existe
# "sesion que nunca expira" de verdad en cookies de navegador). El logout
# manual invalida la sesion en el servidor sin importar este valor.
SESSION_TTL_SECONDS=31536000

# Cuenta admin de arranque. IMPORTANTE: cambia ADMIN_PASSWORD antes de exponer
# el backend al publico, y bórrala de este archivo/entorno cuando ya no la
# necesites — no queda hardcodeada en ningun archivo de código versionado.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
