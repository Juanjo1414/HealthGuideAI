# Para HealthGuideAI_Gemini.ipynb (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Para HealthGuideAI_Gemini.ipynb (NVIDIA) #Estamos trabajando sobre este modelo para la demo
NVIDIA_API_KEY=tu_api_key_de_nvidia_aqui

# Limites de la llamada al proveedor. Evitan requests colgados o reintentos excesivos.
NVIDIA_TIMEOUT_SECONDS=30
NVIDIA_MAX_RETRIES=0

# Por defecto la evidencia NO guarda texto médico ni respuestas completas.
EVIDENCE_INCLUDE_SENSITIVE_PAYLOADS=false
